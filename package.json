{
  "name": "loadout",
  "private": true,
  "type": "module",
  "description": "loadout in TypeScript, compiled by bun into one executable per target (src/main.ts). The Go code beside it is the reference until the port reaches parity.",
  "scripts": {
    "build": "bun build --compile --minify src/main.ts --outfile build/loadout-ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@xterm/headless": "6.0.0",
    "ink": "8.0.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
