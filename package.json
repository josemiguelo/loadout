{
  "name": "loadout",
  "private": true,
  "type": "module",
  "description": "loadout, compiled by bun into one executable per target (src/main.ts); the executable is its own bun.",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1.4.3"
  },
  "scripts": {
    "build": "bun build --compile --minify src/main.ts --outfile build/loadout",
    "test": "bun test src",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@xterm/headless": "6.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
