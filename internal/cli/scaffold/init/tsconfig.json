{
  // "loadout" and "loadout/script" are the SDKs loadout compile writes
  // (loadout.sdk.ts, loadout.script.ts): bun finds them here when it runs the
  // manifests and scripts, and so does the editor, for their types. bun's
  // own types come from bun install.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": { "loadout": ["./loadout.sdk.ts"], "loadout/script": ["./loadout.script.ts"] }
  },
  // Manifests are often dot files (.ripgrep.loadout.ts), which a bare ** skips.
  "include": ["**/*.ts", "**/.*.ts", "**/.*/**/*.ts", "**/.*/**/.*.ts"]
}
