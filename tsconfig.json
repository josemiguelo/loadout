{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "types": ["bun"],
    "paths": {
      "loadout": ["./src/compile/sdk/loadout.sdk.ts"],
      "loadout/script": ["./src/compile/sdk/loadout.script.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
