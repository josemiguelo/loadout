{
  // loadout.d.ts types "loadout" and "loadout/script", the SDKs inside
  // loadout that manifests and scripts import; loadout compile writes it. It
  // is in "files": an include pattern skips it beside loadout.ts.
  // bun's own types come from bun install.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "files": ["loadout.d.ts"],
  // Manifests are often dot files (.ripgrep.loadout.ts), which a bare ** skips.
  "include": ["**/*.ts", "**/.*.ts", "**/.*/**/*.ts", "**/.*/**/.*.ts"]
}
