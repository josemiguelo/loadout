{
  // loadout.d.ts types "loadout" and "loadout/script", the SDKs inside
  // loadout that manifests and scripts import; loadout compile writes it. It
  // is in "files": an include pattern skips it beside loadout.ts.
  // "parent/…" is {{.ParentName}}'s checkout, whose modules this repo imports
  // what it uses from: bun resolves it when it runs the manifests and
  // scripts, and so does the editor, for types.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": { "parent/*": ["{{.ParentImport}}/*"] }
  },
  "files": ["loadout.d.ts"],
  "include": ["**/*.ts", "**/.*.ts", "**/.*/**/*.ts", "**/.*/**/.*.ts"]
}
