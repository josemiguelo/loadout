{
  // "loadout" and "loadout/script", the SDKs inside loadout that manifests
  // and scripts import, are typed by node_modules/@types/loadout, which
  // loadout compile writes.
  // "parent/…" is {{.ParentName}}'s checkout, whose modules this repo imports
  // what it uses from: bun resolves it when it runs the manifests and
  // scripts, and so does the editor, for types.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": { "parent/*": ["{{.ParentImport}}/*"] }
  },
  "include": ["**/*.ts", "**/.*.ts", "**/.*/**/*.ts", "**/.*/**/.*.ts"]
}
